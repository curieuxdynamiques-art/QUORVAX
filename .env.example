# 网站公开 URL（用于 SEO sitemap / robots / canonical）
# 部署到 Vercel 后请在 Environment Variables 中设置为你的真实域名
NEXT_PUBLIC_SITE_URL=https://your-domain.eu

# ---- NextAuth (后台登录认证) ----
# 在 GitHub Settings → Developer settings → OAuth Apps 中创建 OAuth App
# Authorization callback URL 填: https://your-domain.eu/api/auth/callback/github
GITHUB_ID=your_github_oauth_app_client_id
GITHUB_SECRET=your_github_oauth_app_client_secret
# 生产环境必须改为随机字符串（可用 openssl rand -base64 32 生成）
NEXTAUTH_SECRET=your_random_secret_here
# Vercel 部署后设置为你的真实域名
NEXTAUTH_URL=https://your-domain.eu

# ---- 后续接入支付时添加（当前框架不使用）----
# Stripe
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Klarna
# KLARNA_API_KEY=
# KLARNA_API_SECRET=

# 邮件服务（联系表单 / 订单通知）
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
