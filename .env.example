# 网站公开 URL（用于 SEO sitemap / robots / canonical）
# 部署到 Vercel 后请在 Environment Variables 中设置为你的真实域名
NEXT_PUBLIC_SITE_URL=https://your-domain.eu

# ---- NextAuth (后台登录认证) ----
# Google OAuth: 在 https://console.cloud.google.com/ 创建 OAuth 2.0 客户端 ID
# 已授权的 JavaScript 来源: https://your-domain.eu
# 已授权的重定向 URI: https://your-domain.eu/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# 生产环境必须改为随机字符串（可用 openssl rand -base64 32 生成）
NEXTAUTH_SECRET=your_random_secret_here
# Vercel 部署后设置为你的真实域名
NEXTAUTH_URL=https://your-domain.eu

# ---- 后续接入支付时添加（当前框架不使用）----
# Stripe
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Klarna
# KLARNA_API_KEY=
# KLARNA_API_SECRET=

# 邮件服务（联系表单 / 订单通知）
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
